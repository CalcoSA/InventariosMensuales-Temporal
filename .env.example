APP_TIMEZONE=a
MONTHLY_FOLDER_ID=
FORMATS_FOLDER_ID=
# Solo activar después de autorizar operaciones reales.
GOOGLE_WRITES_ENABLED=

# Acceso local sin SSO por defecto. Producción exige AUTH_ENABLED=true y HTTPS.
APP_ENV=
AUTH_ENABLED=
# user_login de WordPress, separados por comas. Vacío = ningún administrador.
# Se aplica trim/minúsculas; no se admiten comodines.
ADMIN_USER_LOGINS=
SSO_ISSUER=
# Audience nuevo y exclusivo de Mensuales.
SSO_AUDIENCE=
SSO_PUBLIC_KEY_PATH=
SSO_TOKEN_MAX_AGE_SECONDS=
SSO_CLOCK_SKEW_SECONDS=
# Secreto propio de Mensuales; nunca reutilizar RSA, OAuth ni el secreto de Uno a Uno.
SESSION_JWT_SECRET=
SESSION_JWT_ISSUER=
SESSION_JWT_AUDIENCE=
SESSION_JWT_COOKIE_NAME=
SESSION_IDLE_TIMEOUT_SECONDS=
SESSION_COOKIE_SECURE=
INTRANET_URL=

# Hosts exactos separados por comas; sin comodines. Los hosts locales se conservan.
TRUSTED_HOSTS=
